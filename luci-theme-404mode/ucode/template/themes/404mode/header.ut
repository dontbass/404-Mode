{#
 404 Mode — cyberpunk / post-collapse theme for LuCI
 https://github.com/dontbass/404-Mode
 Licensed to the public under the Apache License 2.0.

 Variants (same files, symlinked):
   404mode        — follows the browser (prefers-color-scheme) + in-UI switch
   404mode-dark   — forced "ASH" dark
   404mode-light  — forced "SAMIZDAT" light
   404mode-gost   — "ГОСТ-24" dieselpunk bunker skin with live telemetry HUD;
                    dark by default, light via the header switch
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const model = striptags(boardinfo?.model ?? '');
	const gost = (theme == '404mode-gost');
	const forced = (theme == '404mode-dark') ? 'dark' : ((theme == '404mode-light') ? 'light' : '');
	const scheme_default = gost ? 'dark' : 'auto';
	const distver = striptags(version?.distversion ?? '');
	const distmajor = split(distver, '.')[0] || '24';

	/* plate wordmark and emblem follow the running system:
	   OpenWrt → OPEN_WRT, ImmortalWrt → IMMORTAL_WRT, iStoreOS → ISTORE_OS */
	const distname = striptags(version?.distname ?? 'OpenWrt');
	const emblem = match(lc(distname), /immortal/) ? 'immortal' : 'openwrt';
	const dist_uc = uc(replace(distname, /[^A-Za-z0-9]/g, '')) || 'OPENWRT';
	const dist_wm = match(dist_uc, /^(.+?)(WRT|OS)$/);
	const word_a = dist_wm ? dist_wm[1] : dist_uc;
	const word_b = dist_wm ? dist_wm[2] : '';
	const word_len = length(dist_uc) + (word_b ? 1 : 0);
	const ru = (substr(dispatcher.lang ?? '', 0, 2) == 'ru');

	const T = ru ? {
		ticker_tag: 'СЕТЬ ПОД ФИЛЬТРОМ',
		ticker: [
			'ВНИМАНИЕ: ТРАФИК ДОСМАТРИВАЕТСЯ (DPI)',
			'РЕСУРС ЗАБЛОКИРОВАН ПО ТРЕБОВАНИЮ <span class="redact">████████████</span>',
			'СВОБОДНЫЙ ИНТЕРНЕТ — 404 NOT FOUND',
			'ПРОТОКОЛ ЗАМЕДЛЕН',
			'ЗАПИСЬ СОЕДИНЕНИЙ ВЕДЁТСЯ',
			'РЕЖИМ БЕЛЫХ СПИСКОВ: <span class="redact">██████</span>',
			'ТУННЕЛЬ — ЕДИНСТВЕННЫЙ ВЫХОД',
			'ДАННЫЕ ХРАНЯТСЯ <span class="redact">████</span> ЛЕТ',
		],
		uplink: 'АПЛИНК',
		uplink_state: 'ФИЛЬТРУЕТСЯ',
		scheme: 'Тема: авто / тёмная / светлая',
		temp: 'ТЕМП.',
		uptime: 'ВРЕМЯ РАБОТЫ',
		radar: 'РАДАР // КЛИЕНТЫ',
	} : {
		ticker_tag: 'NET UNDER FILTER',
		ticker: [
			'WARNING: DEEP PACKET INSPECTION ACTIVE',
			'RESOURCE BLOCKED BY ORDER OF <span class="redact">████████████</span>',
			'FREE INTERNET — 404 NOT FOUND',
			'PROTOCOL THROTTLED',
			'CONNECTION LOGS RETAINED',
			'WHITELIST MODE: <span class="redact">██████</span>',
			'THE TUNNEL IS THE ONLY WAY OUT',
			'DATA STORED FOR <span class="redact">████</span> YEARS',
		],
		uplink: 'UPLINK',
		uplink_state: 'FILTERED',
		scheme: 'Theme: auto / dark / light',
		temp: 'TEMP.',
		uptime: 'UPTIME',
		radar: 'RADAR // CLIENTS',
	};

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}"{{ gost ? ' data-skin="gost"' : '' }} data-theme="{{ forced || 'dark' }}" data-darkmode="{{ forced == 'light' ? 'false' : 'true' }}" data-scheme="{{ forced || scheme_default }}" data-scheme-default="{{ scheme_default }}"{{ forced ? ' data-scheme-lock="1"' : '' }}>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	{% if (gost): %}
	<meta name="theme-color" content="#161714">
	{% endif %}
	<meta name="theme-color" content="#0b0b0a" media="(prefers-color-scheme: dark)">
	<meta name="theme-color" content="#e9e4d8" media="(prefers-color-scheme: light)">
	<meta name="color-scheme" content="{{ forced || 'dark light' }}">
	<meta name="application-name" content="{{ hostname }} - LuCI">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">
	<title>{{ hostname }}{{ node?.title ? ` // ${striptags(node.title)}` : '' }} - LuCI</title>
	<script>
		(function() {
			var root = document.documentElement,
			    forced = root.getAttribute('data-scheme-lock') ? root.getAttribute('data-scheme') : '',
			    mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null,
			    skin = root.getAttribute('data-skin') || 'base',
			    key = (skin == 'gost') ? '404mode.gost.scheme' : '404mode.scheme',
			    def = root.getAttribute('data-scheme-default') || 'auto';

			function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
			function set(k, v) { try { v ? localStorage.setItem(k, v) : localStorage.removeItem(k); } catch (e) {} }

			function apply() {
				var pref = forced || get(key) || def,
				    dark = (pref == 'dark') || (pref == 'auto' && (!mq || mq.matches));

				root.setAttribute('data-scheme', pref);
				root.setAttribute('data-theme', dark ? 'dark' : 'light');
				root.setAttribute('data-darkmode', dark ? 'true' : 'false');
				document.dispatchEvent(new CustomEvent('404mode-scheme', { detail: { scheme: pref, dark: dark } }));
				broadcast();
			}

			/* embedded apps (Modem WebUI on :8001 etc.) follow the theme via postMessage */
			function state() {
				return { source: '404mode', v: 1, skin: skin, theme: root.getAttribute('data-theme'), fx: !root.classList.contains('no-fx') };
			}

			function broadcast() {
				var frames = document.getElementsByTagName('iframe');
				for (var i = 0; i < frames.length; i++)
					try { frames[i].contentWindow.postMessage(state(), '*'); } catch (e) {}
			}

			window.addEventListener('message', function(ev) {
				if (ev.data && ev.data.source == '404mode-client' && ev.source)
					try { ev.source.postMessage(state(), '*'); } catch (e) {}
			});

			window.__404scheme = {
				locked: !!forced,
				get: function() { return forced || get(key) || def; },
				set: function(v) { if (!forced) { set(key, v == def ? null : v); apply(); } },
				broadcast: broadcast
			};

			if (mq && mq.addEventListener)
				mq.addEventListener('change', apply);

			if (get('404mode.fx') === 'off')
				root.classList.add('no-fx');
			if (get('404mode.nav') === 'mini')
				root.classList.add('nav-mini');

			apply();
		})();
	</script>
	<link rel="stylesheet" href="{{ media }}/cascade.css">
	<link rel="stylesheet" media="screen and (max-width: 854px)" href="{{ media }}/mobile.css">
	{% if (gost): %}
	<link rel="stylesheet" href="{{ media }}/gost/gost.css">
	{% endif %}
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any" type="image/svg+xml">
	<link rel="icon" href="{{ media }}/logo_48.png" sizes="48x48">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style title="text/css">{{ css }}</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
</head>

<body class="lang_{{ dispatcher.lang }} {{ blank_page ? 'page-blank' : '' }} {{ ctx.authsession ? 'logged-in' : '' }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
<script>
	/* apps that follow LuCI's theme via <body theme=…> (iStoreOS QuickStart, iStore) */
	(function(b, r) {
		var sync = function() { b.setAttribute('theme', r.getAttribute('data-theme') || 'dark'); };
		sync();
		document.addEventListener('404mode-scheme', sync);
	})(document.body, document.documentElement);
</script>
<div class="n-ambient" aria-hidden="true"><i class="n-amb-a"></i><i class="n-amb-b"></i><i class="n-amb-c"></i></div>
{% if (!blank_page): %}
<header class="hud">
	<button type="button" class="hud-toggle" id="nav-toggle" aria-label="Menu" aria-controls="sidebar" aria-expanded="false">
		<span></span><span></span><span></span>
	</button>

	<a class="brand" href="/" title="{{ entityencode(model, true) }}">
		<span class="brand-code glitch" data-text="404">404</span>
		<span class="brand-sep">://</span>
		<span class="brand-host">{{ hostname }}</span>
	</a>

	<div class="hud-meta">
		{% if (gost): %}
		<span class="hud-cell hud-dist">{{ striptags(version?.distname ?? 'OpenWrt') }} {{ distver }}</span>
		{% endif %}
		<span class="hud-cell hud-model">{{ model || 'OpenWrt' }}</span>
		<span class="hud-cell hud-clock" id="hud-clock">--:--:--</span>
	</div>

	<div class="hud-brief" id="hud-brief" hidden></div>

	<div id="indicators" class="hud-indicators"></div>

	<div class="hud-switches">
		{% if (!forced): %}
		<button type="button" class="hud-sw hud-scheme" id="scheme-toggle" title="{{ T.scheme }}" aria-label="{{ T.scheme }}">
			<span class="hud-scheme-icon" aria-hidden="true"></span>
			<span class="hud-scheme-label">AUTO</span>
		</button>
		{% endif %}
		<button type="button" class="hud-sw hud-fx" id="fx-toggle" title="FX on/off" aria-label="FX on/off">FX</button>
	</div>
</header>

{% if (!gost): %}
<div class="hud-ticker" aria-hidden="true">
	<span class="hud-ticker-tag">&#x26A0; {{ T.ticker_tag }}</span>
	<div class="hud-ticker-track">
		<div class="hud-ticker-run">
			{% for (let pass = 0; pass < 2; pass++): %}
			{% for (let msg in T.ticker): %}<span class="hud-ticker-msg">{{ msg }}</span>{% endfor %}
			{% endfor %}
		</div>
	</div>
</div>
{% endif %}

<div class="shell">
	<aside class="sidebar" id="sidebar">
		<div class="sidebar-scan" aria-hidden="true"></div>
		{% if (gost): %}
		<div class="gost-plate gost-plate-{{ emblem }}" aria-hidden="true">
			{% include('themes/404mode/mark', { emblem }) %}
			<div class="gost-plate-text">
				<span class="gost-plate-tags">
					<span class="gost-plate-tag gost-plate-tag-l">СТС &#x2022; {{ distver || '24' }}</span>
					<span class="gost-plate-tag gost-plate-tag-r">ГОСТ-{{ distmajor }}</span>
				</span>
				<span class="gost-plate-title" style="--len:{{ word_len }}">{{ word_a }}{% if (word_b): %}<i>_</i>{{ word_b }}{% endif %}</span>
				<span class="gost-plate-num">{{ distmajor }}</span>
				<span class="gost-plate-sub">{{ T.uplink }}: {{ T.uplink_state }}</span>
			</div>
		</div>
		{% endif %}
		<nav id="mainmenu" style="display:none"></nav>
		<ul id="modemenu" style="display:none"></ul>
		{% if (gost): %}
		<div class="gost-radar" id="gost-radar">
			<div class="gost-radar-scope" aria-hidden="true">
				<div class="gost-radar-sweep"></div>
				<div class="gost-radar-blips" id="gost-blips"></div>
			</div>
			<div class="gost-radar-side">
				<div class="gost-radar-title">{{ T.radar }}</div>
				<ol class="gost-radar-log" id="gost-log"></ol>
			</div>
			<div class="gost-radar-foot">
				<span>{{ T.temp }} <b id="gost-temp">--</b></span>
				<span>{{ T.uptime }} <b id="gost-uptime">--</b></span>
			</div>
		</div>
		{% endif %}
		<div class="sidebar-uplink" aria-hidden="true">
			<span class="sidebar-uplink-dot"></span>
			<span class="sidebar-uplink-label">{{ T.uplink }}:</span>
			<span class="sidebar-uplink-state">{{ T.uplink_state }}</span>
		</div>
		<button type="button" class="sidebar-collapse" id="nav-collapse" aria-label="Collapse menu">
			<span class="sidebar-collapse-icon" aria-hidden="true">&#x25C2;</span>
			<span class="sidebar-collapse-label">MINIMIZE</span>
		</button>
	</aside>
	<div class="shell-mask" id="nav-mask"></div>

	<main id="maincontent">
		{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && join('/', ctx.request_path) != 'admin/system/admin'): %}
			<div class="alert-message warning">
				<h4>{{ _('No password set!') }}</h4>
				<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
				{% if (dispatcher.lookup("admin/system/admin")): %}
				<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
				{% endif %}
			</div>
		{% endif %}

		{% if (boardinfo?.rootfs_type == "initramfs"): %}
			<div class="alert-message warning">
				<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
				<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
				{% if (dispatcher.lookup("admin/system/flash")): %}
				<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
				{% endif %}
			</div>
		{% endif %}

		<noscript>
			<div class="alert-message warning">
				<h4>{{ _('JavaScript required!') }}</h4>
				<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
			</div>
		</noscript>

		<div id="tabmenu" style="display:none"></div>
{% endif %}

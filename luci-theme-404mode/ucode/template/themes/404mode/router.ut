{#
 # 404 Mode — the router as a drawing: a flat box, seven antennas on SMA
 # connectors, five status lights, the theme's emblem on the lid.
 # p: id prefix (the drawing appears more than once on a page), cls: extra class.
 #}
<svg class="rt-art {{ cls }}" viewBox="0 0 520 400" aria-hidden="true" focusable="false">
	<defs>
		<linearGradient id="{{ p }}-edge" x1="0" y1="1" x2="1" y2="0"><stop offset="0" class="sp-s-volt"/><stop offset="1" class="sp-s-cyan"/></linearGradient>
		<linearGradient id="{{ p }}-body" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="sp-s-body-a"/><stop offset="1" class="sp-s-body-b"/></linearGradient>
		<linearGradient id="{{ p }}-gold" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8A5A12"/><stop offset=".35" stop-color="#F6D27A"/><stop offset=".6" stop-color="#D9A441"/><stop offset="1" stop-color="#7A4E0E"/></linearGradient>
		<linearGradient id="{{ p }}-rod" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0B0E13"/><stop offset=".45" stop-color="#2A313B"/><stop offset="1" stop-color="#07090C"/></linearGradient>
		<linearGradient id="{{ p }}-sheen" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".22"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
		<clipPath id="{{ p }}-clip-body"><rect x="56" y="204" width="408" height="170" rx="14"/></clipPath>
		<clipPath id="{{ p }}-clip-sky"><rect x="0" y="-40" width="520" height="190"/></clipPath>
	</defs>

	<g class="sp-waves" clip-path="url(#{{ p }}-clip-sky)"><circle class="sp-wave" stroke="url(#{{ p }}-edge)" style="--i:0" cx="260" cy="150" r="150"/><circle class="sp-wave" stroke="url(#{{ p }}-edge)" style="--i:1" cx="260" cy="150" r="150"/><circle class="sp-wave" stroke="url(#{{ p }}-edge)" style="--i:2" cx="260" cy="150" r="150"/></g>

	<g class="sp-ants">
<g class="sp-ant" style="--i:0">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="100.0" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="104.5" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="112.0" y1="172" x2="112.0" y2="24"/>
	<circle class="sp-tip" cx="112.0" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="103.0" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="100.0" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="103.0" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="104.5" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:1">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="149.4" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="153.9" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="161.4" y1="172" x2="161.4" y2="24"/>
	<circle class="sp-tip" cx="161.4" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="152.4" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="149.4" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="152.4" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="153.9" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:2">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="198.8" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="203.3" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="210.8" y1="172" x2="210.8" y2="24"/>
	<circle class="sp-tip" cx="210.8" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="201.8" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="198.8" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="201.8" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="203.3" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:3">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="248.2" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="252.7" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="260.2" y1="172" x2="260.2" y2="24"/>
	<circle class="sp-tip" cx="260.2" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="251.2" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="248.2" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="251.2" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="252.7" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:4">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="297.6" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="302.1" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="309.6" y1="172" x2="309.6" y2="24"/>
	<circle class="sp-tip" cx="309.6" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="300.6" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="297.6" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="300.6" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="302.1" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:5">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="347.0" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="351.5" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="359.0" y1="172" x2="359.0" y2="24"/>
	<circle class="sp-tip" cx="359.0" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="350.0" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="347.0" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="350.0" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="351.5" y="198" width="15" height="9" rx="1"/>
</g>
<g class="sp-ant" style="--i:6">
	<rect class="sp-rod" fill="url(#{{ p }}-rod)" x="396.4" y="16" width="24" height="162" rx="11"/>
	<rect class="sp-rod-hi" x="400.9" y="26" width="4" height="142" rx="2"/>
	<line class="sp-flow" x1="408.4" y1="172" x2="408.4" y2="24"/>
	<circle class="sp-tip" cx="408.4" cy="18" r="5"/>
	<rect class="sp-nut" fill="url(#{{ p }}-gold)" x="399.4" y="174" width="18" height="11" rx="2"/>
	<rect class="sp-nut sp-nut-b" fill="url(#{{ p }}-gold)" x="396.4" y="184" width="24" height="15" rx="2.5"/>
	<rect class="sp-nut-hi" x="399.4" y="186" width="5" height="10" rx="1"/>
	<rect class="sp-nut sp-thread" x="400.9" y="198" width="15" height="9" rx="1"/>
</g>
	</g>

	<g class="sp-box">
		<rect class="sp-lip" x="56" y="214" width="408" height="170" rx="14"/>
		<rect class="sp-shell" fill="url(#{{ p }}-body)" stroke="url(#{{ p }}-edge)" x="56" y="204" width="408" height="170" rx="14"/>
		<rect class="sp-inset" x="66" y="214" width="388" height="150" rx="9"/>
		<g clip-path="url(#{{ p }}-clip-body)"><rect class="sp-sheen" fill="url(#{{ p }}-sheen)" x="-140" y="190" width="120" height="200" transform="skewX(-18)"/></g>
		<g class="sp-emblem" transform="translate(212 247) scale(2)">
			<path class="sp-emblem-glow" d="M8 24c0-5 4-8 8-8 7 0 9 16 16 16 4 0 8-3 8-8s-4-8-8-8c-7 0-9 16-16 16-4 0-8-3-8-8z"/>
			<path class="sp-emblem-line" stroke="url(#{{ p }}-edge)" pathLength="100" d="M8 24c0-5 4-8 8-8 7 0 9 16 16 16 4 0 8-3 8-8s-4-8-8-8c-7 0-9 16-16 16-4 0-8-3-8-8z"/>
		</g>
		<g class="sp-leds"><circle class="sp-led" style="--i:0" cx="372" cy="352" r="3.6"/><circle class="sp-led" style="--i:1" cx="389" cy="352" r="3.6"/><circle class="sp-led" style="--i:2" cx="406" cy="352" r="3.6"/><circle class="sp-led" style="--i:3" cx="423" cy="352" r="3.6"/><circle class="sp-led" style="--i:4" cx="440" cy="352" r="3.6"/></g>
	</g>
</svg>

{#
 404 Mode — cyberpunk / post-collapse theme for LuCI
 https://github.com/dontbass/404-Mode
 Licensed to the public under the Apache License 2.0.
-#}

{% if (!blank_page): %}
		<footer class="hud-footer">
			<span class="hud-footer-tag">SYS//ONLINE</span>
			<span class="hud-footer-tag hud-footer-warn">NET//<span class="redact">CENSORED</span></span>
			<span>
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
				/
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
				{% if (lua_active): %}
				/ {{ _('Lua compatibility mode active') }}
				{% endif %}
			</span>
			<a class="hud-footer-tag" href="https://github.com/dontbass/404-Mode" target="_blank" rel="noreferrer">404 MODE</a>
		</footer>
	</main>
</div>
<script src="{{ resource }}/nfx-404mode.js?v=1.9.1"></script>
<script>L.require('menu-404mode')</script>
<script>L.require('brief-404mode')</script>
{% if (theme == '404mode-gost'): %}
<script>L.require('hud-404mode')</script>
{% endif %}
{% endif %}
</body>
</html>

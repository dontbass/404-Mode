{
	"luci-theme-404mode": {
		"description": "404 Mode theme: header brief, dashboard, proxy panel",
		"read": {
			"ubus": {
				"404mode": [
					"weather",
					"rates",
					"news",
					"proxy",
					"cell"
				],
				"qmodem": [
					"info",
					"base_info",
					"cell_info",
					"sim_info",
					"network_info",
					"get_stats",
					"get_sim_switch_capabilities",
					"get_sim_slot"
				],
				"system": [
					"info",
					"board"
				],
				"luci-rpc": [
					"getNetworkDevices"
				],
				"network.interface": [
					"dump"
				],
				"rc": [
					"list"
				],
				"file": [
					"read"
				]
			},
			"uci": [
				"qmodem",
				"nikki"
			],
			"file": {
				"/proc/stat": [
					"read"
				],
				"/sys/class/thermal/thermal_zone*/temp": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"404mode": [
					"proxy_set"
				],
				"qmodem": [
					"set_sim_slot"
				],
				"file": [
					"write",
					"remove"
				]
			},
			"file": {
				"/www/luci-static/resources/404mode-op/*": [
					"write"
				]
			}
		}
	}
}

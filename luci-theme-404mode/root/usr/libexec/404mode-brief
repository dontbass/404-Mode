#!/usr/bin/ucode
/*
 * 404 Mode — header brief fetcher (run in the background by the rpcd plugin
 * /usr/share/rpcd/ucode/404mode.uc, so slow sources never block rpcd).
 *
 *   404mode-brief weather <city>
 *   404mode-brief rates
 *   404mode-brief news
 *
 * Writes /tmp/404mode-brief/<key>.json; keeps the old file when a fetch fails.
 *
 * https://github.com/dontbass/404-Mode — Apache-2.0
 */

'use strict';

import { popen, readfile, writefile, mkdir, rename, unlink } from 'fs';

const DIR = '/tmp/404mode-brief';

/* default feeds; /etc/404mode/feeds overrides them, one per line:
 *   Name https://example.org/rss
 * (empty lines and lines starting with # are skipped) */
const NEWS_DEFAULT = [
	{ name: 'Хабр',    url: 'https://habr.com/ru/rss/news/?fl=ru' },
	{ name: '3DNews',  url: 'https://3dnews.ru/news/rss/' },
	{ name: 'OpenNet', url: 'https://www.opennet.ru/opennews/opennews_all_utf.rss' },
	{ name: 'iXBT',    url: 'https://www.ixbt.com/export/news.rss' },
	{ name: 'Лента',   url: 'https://lenta.ru/rss/news' },
	{ name: 'РБК',     url: 'https://rssexport.rbc.ru/rbcnews/news/30/full.rss' },
	{ name: 'Интерфакс', url: 'https://www.interfax.ru/rss.asp' }
];

const PER_FEED = 6;
const MAX_ITEMS = 40;
const OG_FETCH = 10;      /* article pages fetched per run for a missing picture */

function shellquote(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

function fetch(url) {
	const p = popen('uclient-fetch -q -T 8 -O - ' + shellquote(url) + ' 2>/dev/null', 'r');

	if (!p)
		return null;

	const data = p.read('all');
	p.close();

	return length(data) ? data : null;
}

function fetch_json(url) {
	const data = fetch(url);
	let res = null;

	if (data)
		try { res = json(data); } catch (e) { res = null; }

	return res;
}

function urlencode(s) {
	let out = '';

	for (let i = 0; i < length(s); i++) {
		const c = ord(s, i);

		if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 || c == 126)
			out += chr(c);
		else
			out += sprintf('%%%02X', c);
	}

	return out;
}

function between(s, a, b) {
	const i = index(s, a);

	if (i < 0)
		return null;

	const rest = substr(s, i + length(a));
	const j = index(rest, b);

	return (j < 0) ? null : substr(rest, 0, j);
}

function clean(s) {
	if (s == null)
		return null;

	s = trim(s);

	if (index(s, '<![CDATA[') == 0)
		s = substr(s, 9, length(s) - 12);

	s = replace(s, /<[^>]*>/g, '');
	s = replace(s, /&quot;/g, '"');
	s = replace(s, /&#0?39;|&apos;/g, "'");
	s = replace(s, /&laquo;/g, '«');
	s = replace(s, /&raquo;/g, '»');
	s = replace(s, /&nbsp;/g, ' ');
	s = replace(s, /&mdash;/g, '—');
	s = replace(s, /&ndash;/g, '–');
	s = replace(s, /&lt;/g, '<');
	s = replace(s, /&gt;/g, '>');
	s = replace(s, /&amp;/g, '&');
	s = replace(s, /[ \t\r\n]+/g, ' ');

	return trim(s);
}

/* picture for the wallpaper: enclosure / media:content / first <img> */
function item_image(it) {
	let body = replace(it, /&quot;/g, '"');
	body = replace(body, /&lt;/g, '<');
	body = replace(body, /&amp;/g, '&');

	let url = null;

	for (let tag in [ '<enclosure', '<media:content', '<media:thumbnail', '<img' ]) {
		const i = index(body, tag);

		if (i < 0)
			continue;

		const rest = substr(body, i, 600);
		const m = match(rest, /(url|src)="(https:\/\/[^"]+)"/);

		if (m) {
			url = m[2];
			break;
		}
	}

	return (url && length(url) < 400 && !match(url, /[ <>'\\]/)) ? url : null;
}

function rss_items(xml, src, max) {
	const out = [];
	const parts = split(xml, '<item');

	for (let i = 1; i < length(parts) && length(out) < max; i++) {
		const it = parts[i];
		const title = clean(between(it, '<title>', '</title>'));
		const link = clean(between(it, '<link>', '</link>'));

		if (title && link && match(link, /^https?:\/\//)) {
			const item = { t: title, l: link, s: src.name };
			const img = item_image(it);

			if (img)
				item.i = img;

			push(out, item);
		}
	}

	return out;
}

function weather_key(city) {
	return 'wx-' + substr(replace(urlencode(lc(city)), '%', ''), 0, 96);
}

function get_weather(city) {
	const geo = fetch_json('https://geocoding-api.open-meteo.com/v1/search?count=1&language=ru&format=json&name=' + urlencode(city));
	const place = geo?.results?.[0];

	if (!place || place.latitude == null || place.longitude == null)
		return { error: 'city' };

	const wx = fetch_json(sprintf('https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f' +
		'&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,is_day' +
		'&wind_speed_unit=ms&timezone=auto', place.latitude, place.longitude));
	const cur = wx?.current;

	if (!cur || cur.temperature_2m == null)
		return null;

	return {
		city: place.name, country: place.country,
		t: cur.temperature_2m, feels: cur.apparent_temperature,
		code: cur.weather_code, wind: cur.wind_speed_10m,
		day: cur.is_day, time: cur.time
	};
}

function get_rates() {
	const cbr = fetch_json('https://www.cbr-xml-daily.ru/daily_json.js');
	const v = cbr?.Valute;

	if (!v?.USD)
		return null;

	const res = { date: cbr.Date, list: [] };

	for (let code in [ 'USD', 'EUR', 'CNY' ])
		if (v[code])
			push(res.list, { code, v: v[code].Value / (v[code].Nominal || 1), p: v[code].Previous / (v[code].Nominal || 1) });

	return res;
}

function feeds() {
	const text = readfile('/etc/404mode/feeds');
	const list = [];

	if (text)
		for (let line in split(text, '\n')) {
			line = trim(line);

			if (!length(line) || substr(line, 0, 1) == '#')
				continue;

			const m = match(line, /^(.*[^ \t])[ \t]+(https?:\/\/[^ \t]+)$/);

			if (m)
				push(list, { name: m[1], url: m[2] });
		}

	return length(list) ? list : NEWS_DEFAULT;
}

/* some Russian feeds are still windows-1251: convert them to UTF-8 */
/* bytes 0x80..0xBF (0 = unmapped); 0xC0..0xFF are А..я */
const CP1251_HI = [
	0x0402, 0x0403, 0x201A, 0x0453, 0x201E, 0x2026, 0x2020, 0x2021,
	0x20AC, 0x2030, 0x0409, 0x2039, 0x040A, 0x040C, 0x040B, 0x040F,
	0x0452, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
	0x0000, 0x2122, 0x0459, 0x203A, 0x045A, 0x045C, 0x045B, 0x045F,
	0x00A0, 0x040E, 0x045E, 0x0408, 0x00A4, 0x0490, 0x00A6, 0x00A7,
	0x0401, 0x00A9, 0x0404, 0x00AB, 0x00AC, 0x00AD, 0x00AE, 0x0407,
	0x00B0, 0x00B1, 0x0406, 0x0456, 0x0491, 0x00B5, 0x00B6, 0x00B7,
	0x0451, 0x2116, 0x0454, 0x00BB, 0x0458, 0x0405, 0x0455, 0x0457
];

function utf8(cp) {
	if (cp < 0x80) return chr(cp);
	if (cp < 0x800) return chr(0xC0 | (cp >> 6), 0x80 | (cp & 0x3F));
	return chr(0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F));
}

function to_utf8(xml) {
	const head = substr(xml, 0, 200);

	if (!match(head, /encoding=["'](windows-1251|cp1251)["']/i))
		return xml;

	const out = [];

	for (let i = 0; i < length(xml); i++) {
		const b = ord(xml, i);

		if (b < 0x80)
			push(out, chr(b));
		else if (b >= 0xC0)
			push(out, utf8(0x0410 + b - 0xC0));
		else if (CP1251_HI[b - 0x80])
			push(out, utf8(CP1251_HI[b - 0x80]));
	}

	return join('', out);
}

/* og:image of an article page, for feeds that carry no pictures */
function og_image(url) {
	const p = popen('uclient-fetch -q -T 6 -O - ' + shellquote(url) + ' 2>/dev/null | head -c 131072', 'r');

	if (!p)
		return null;

	const html = p.read('all');
	p.close();

	if (!html)
		return null;

	let m = match(html, /<meta[^>]+property=["']og:image["'][^>]*content=["']([^"']+)["']/);

	if (!m)
		m = match(html, /<meta[^>]+content=["']([^"']+)["'][^>]*property=["']og:image["']/);

	const img = m ? replace(m[1], /&amp;/g, '&') : null;

	return (img && match(img, /^https:\/\//) && length(img) < 400 && !match(img, /[ <>'\\]/)) ? img : null;
}

function get_news() {
	const lists = [];

	for (let src in feeds()) {
		const xml = fetch(src.url);
		push(lists, xml ? rss_items(to_utf8(xml), src, PER_FEED) : []);
	}

	/* interleave the sources */
	const items = [];

	for (let i = 0; i < PER_FEED; i++)
		for (let l in lists)
			if (l[i] && length(items) < MAX_ITEMS)
				push(items, l[i]);

	if (!length(items))
		return null;

	/* pictures found earlier are kept per link, so pages are fetched once */
	let known = {};

	try { known = json(readfile(DIR + '/news-img.json') ?? '{}') ?? {}; } catch (e) { known = {}; }

	let budget = OG_FETCH;
	const seen = {};

	for (let it in items) {
		if (it.i) {
			seen[it.l] = it.i;
			continue;
		}

		if (exists(known, it.l)) {
			if (known[it.l])
				it.i = known[it.l];

			seen[it.l] = known[it.l];
			continue;
		}

		if (budget-- > 0) {
			it.i = og_image(it.l);
			seen[it.l] = it.i ?? false;
		}
	}

	writefile(DIR + '/news-img.json', sprintf('%J', seen));

	/* the same picture on several articles is a site logo, not a photo */
	const count = {};

	for (let it in items)
		if (it.i)
			count[it.i] = (count[it.i] ?? 0) + 1;

	for (let it in items)
		if (!it.i || count[it.i] > 1)
			delete it.i;

	return { items };
}

const kind = ARGV[0];
let key, res;

if (kind == 'weather') {
	const city = trim(ARGV[1] ?? '');

	if (!length(city) || length(city) > 64)
		exit(1);

	key = weather_key(city);
}
else if (kind == 'rates' || kind == 'news') {
	key = kind;
}
else {
	warn('usage: 404mode-brief weather <city> | rates | news\n');
	exit(1);
}

mkdir(DIR);
writefile(DIR + '/' + key + '.lock', '');

if (kind == 'weather')
	res = get_weather(trim(ARGV[1]));
else if (kind == 'rates')
	res = get_rates();
else
	res = get_news();

if (res) {
	res.ts = time();
	writefile(DIR + '/' + key + '.json.tmp', sprintf('%J', res));
	rename(DIR + '/' + key + '.json.tmp', DIR + '/' + key + '.json');
}

unlink(DIR + '/' + key + '.lock');

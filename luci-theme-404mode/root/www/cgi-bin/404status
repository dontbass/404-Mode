#!/bin/sh
# 404 Mode — router status for the phone app and the Android widget.
# GET /cgi-bin/404status with "Authorization: Bearer <token>" or ?t=<token>;
# the key reads the status and may switch the proxy node, nothing else;
# the token lives in /etc/404mode/token (LuCI: System › Phone app).
# https://github.com/dontbass/404-Mode — Apache-2.0

TOKEN="$(cat /etc/404mode/token 2>/dev/null)"

given=""
case "$HTTP_AUTHORIZATION" in
	Bearer\ *) given="${HTTP_AUTHORIZATION#Bearer }" ;;
esac
if [ -z "$given" ]; then
	given="$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n 's/^t=//p' | head -n1)"
fi

reply() {
	printf 'Status: %s\r\nContent-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: Authorization, Content-Type\r\n\r\n' "$1"
}

if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
	reply "204 No Content"
	exit 0
fi

if [ -z "$TOKEN" ] || [ "$given" != "$TOKEN" ]; then
	reply "403 Forbidden"
	echo '{"error":"token"}'
	exit 0
fi

# what the key may do besides reading: switch the proxy node (and test delays)
#   GET  ?a=proxies                         groups and nodes of mihomo
#   POST {"action":"select","group":…,"name":…}
#   POST {"action":"unfix","group":…}        URLTest/Fallback back to automatic
#   POST {"action":"group_delay","group":…}
if [ "$REQUEST_METHOD" = "POST" ]; then
	body="$(head -c "${CONTENT_LENGTH:-0}" 2>/dev/null)"
	action="$(printf '%s' "$body" | jsonfilter -e '@.action' 2>/dev/null)"
	group="$(printf '%s' "$body" | jsonfilter -e '@.group' 2>/dev/null)"
	name="$(printf '%s' "$body" | jsonfilter -e '@.name' 2>/dev/null)"
	case "$action" in
		select|unfix|group_delay) ;;
		*) reply "400 Bad Request"; echo '{"error":"action"}'; exit 0 ;;
	esac
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string action "$action"
	[ -n "$group" ] && json_add_string group "$group"
	[ -n "$name" ] && json_add_string name "$name"
	reply "200 OK"
	ubus -t 25 call 404mode proxy_set "$(json_dump)" 2>/dev/null || echo '{"error":"rpcd"}'
	exit 0
fi

case "&$QUERY_STRING&" in
	*"&a=proxies&"*)
		reply "200 OK"
		ubus -t 25 call 404mode proxy 2>/dev/null || echo '{"error":"rpcd"}'
		exit 0
		;;
esac

reply "200 OK"
ubus -t 25 call 404mode status 2>/dev/null || echo '{"error":"rpcd"}'

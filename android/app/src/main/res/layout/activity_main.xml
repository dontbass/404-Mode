<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Роутер 404"
            android:textColor="@color/ink"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Виджет с состоянием роутера: интернет, нода прокси, сигнал LTE."
            android:textColor="@color/dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/field_bg"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="Не настроено"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Адрес роутера"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/field_bg"
            android:fontFamily="monospace"
            android:hint="192.168.88.1"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/faint"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ключ доступа"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/field_bg"
            android:fontFamily="monospace"
            android:hint="32 символа"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/faint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Проще всего: откройте приложение роутера в браузере и нажмите «Настроить виджет», адрес и ключ подставятся сами. Ключ есть и в LuCI: Система › Приложение на телефон."
            android:textColor="@color/faint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_bg"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Сохранить и проверить"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:stateListAnimator="@null"
            android:text="Добавить виджет на экран"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/open"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:stateListAnimator="@null"
            android:text="Открыть приложение роутера"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
